# FatSecret Platform API — OAuth2 client credentials (Premier Free tier, D-001)
# ห้าม commit ค่าจริงลงไฟล์นี้ — ใส่เฉพาะชื่อ key (CLAUDE.md §Secret hygiene)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริงบน VPS เท่านั้น
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_SCOPE=premier

# Proxy server config
PORT=3000
ALLOWED_ORIGIN=https://vfullcycle.github.io

# Anthropic API — Thai<->English food name translation (D-015) + AI Import nutrition
# estimation (D-023/FR-FOOD-7, 2026-08-19) — same key, both draw from the one prepaid credit
ANTHROPIC_API_KEY=

# Supabase — used to verify a caller's access token on /translate (D-015 amendment,
# 2026-08-13) and to call the get_daily_totals_for_token RPC on /health/daily-summary
# (D-020, 2026-08-14). SUPABASE_ANON_KEY is the same public anon key already embedded in
# the web client bundle (web/src/config.ts) — not a secret, but keep it env-configured for parity.
SUPABASE_URL=
SUPABASE_ANON_KEY=
